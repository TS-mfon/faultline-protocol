# TESTNET ONLY. Copy to .env.local for Next and export explicitly for the worker.
# Public evidence. Use a replica-set MongoDB Atlas database; transactions are required.
MONGODB_URI=
MONGODB_DATABASE=faultline
PUBLIC_ORIGIN=http://localhost:3000
# At least 32 random bytes, only for short-lived API sessions. Never a wallet key.
AUTH_SECRET=
GENLAYER_RPC_URL=https://rpc-bradbury.genlayer.com
# Optional direct L2 transport for standard EVM calls; intelligent calls retain the Bradbury RPC.
GENLAYER_EVM_RPC_URL=https://rpc.testnet-chain.genlayer.com
GENLAYER_CONTRACT_ADDRESS=
# SHA256 of the exact deployed Python source bytes
GENLAYER_CODE_HASH=
BASE_RPC_URL=https://sepolia.base.org
BASE_ESCROW_ADDRESS=
# SHA256 of the exact deployed runtime bytes, including constructor immutables
BASE_CODE_HASH=
# Public EOA addresses; verified against deployed contracts
ATTESTOR_ADDRESS=
GUARDIAN_ADDRESS=
# Worker-only secrets, never NEXT_PUBLIC_ or in API/frontend builds
ATTESTOR_PRIVATE_KEY=
# Optional operator-owned webhook receiver. Worker-only; leave unset to retain the outbox.
FAULTLINE_WEBHOOK_URL=
FAULTLINE_WEBHOOK_SECRET=
# GenLayer is the only adjudicator. Demo work uses a labeled deterministic harness;
# no separate model-provider credential is required.
# Separate demo actors and nonliable repairer. Fund ONLY testnets.
DEMO_AGENT_A_PRIVATE_KEY=
DEMO_AGENT_B_PRIVATE_KEY=
DEMO_AGENT_C_PRIVATE_KEY=
DEMO_REPAIRER_PRIVATE_KEY=

# Caller runner and public release verification
FAULTLINE_API_URL=
PUBLIC_REPOSITORY_URL=
# Protected demonstration scheduler. The first run freezes exactly nine identities in MongoDB.
FAULTLINE_DEMOS_ENABLED=false
FAULTLINE_DEMO_RUN_PREFIX=release-v1
# Deployment only; never in the web or worker environment
DEPLOYER_PRIVATE_KEY=
